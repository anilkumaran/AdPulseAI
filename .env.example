# OLLAMA=true  → local Ollama via ollama.Client().generate() — set OLLAMA_MODEL (required)
# OLLAMA=false or unset → Gemini gemini-2.5-flash (needs GEMINI_API_KEY)
ENV_MODE=prod   #  prod | test
OLLAMA=true     # Provide GEMINI_API_KEY if OLLAMA=false
OLLAMA_MODEL=llama2
#GEMINI_API_KEY=your_gemini_api_key_here

############# Common ###############
PORT=8000

# AWS SNS Configuration (for SMS sending)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=ap-south-1
