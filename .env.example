# Default behavior when OLLAMA is unset:
# - Try local Ollama (Llama) first
# - Fall back to Gemini if Ollama/model is unavailable
#
# Control switches:
# - OLLAMA=false  → skip Ollama and force Gemini
# - OLLAMA=true   → Ollama ONLY (no Gemini fallback). Fix Ollama/model or set OLLAMA=false for Gemini.
#
# Model selection:
# - OLLAMA_MODEL=llama2
# - Optionally set a list of candidates (first installed one wins):
#   LLM_MODEL_CANDIDATES=llama3,llama3.1,llama2
ENV_MODE=prod   #  prod | test
OLLAMA=true
OLLAMA_MODEL=llama2
#LLM_MODEL_CANDIDATES=llama3,llama3.1,llama2
#GEMINI_API_KEY=your_gemini_api_key_here

############# Common ###############
PORT=8000

# AWS SNS Configuration (for SMS sending)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=ap-south-1
